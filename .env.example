# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./samvaad.db
# Which LLM answers: mock | sarvam | gemini | anthropic. mock needs no key and makes no network calls.
LLM_PROVIDER=mock
# If the chosen provider errors or stays rate-limited, try the next configured one in this order, then mock.
LLM_FALLBACK_ORDER=sarvam,gemini,anthropic
LLM_MAX_RETRIES=2                # retries on 429 / 503, with backoff
# Sarvam AI (Indian languages; docs.sarvam.ai). sarvam-30b is deprecated by Sarvam, so tagging uses 105b too.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_FAST_MODEL=sarvam-105b
SARVAM_TOOL_MODE=native          # native | backend (backend: the server calls the data tools itself every turn)
SARVAM_REASONING_EFFORT=low      # counselling replies (low | high | none)
SARVAM_FAST_REASONING_EFFORT=none   # tagging / goal matching: none, or small JSON tasks can return nothing
SARVAM_VOICE_FALLBACK=true       # Sarvam speech only when the browser has no voice for the language
# Google Gemini (free tier), via its OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_TOOL_MODE=native
# Anthropic Claude (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACKS=                # "default" enables server-side refusal fallback (verify with a real call first)
ADMIN_PIN=change-me
COUNSELLOR_PIN=change-me
PHONE_ENCRYPTION_KEY=            # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORS_ORIGINS=http://localhost:5173
# Optional: income bands (comma-separated slugs) if the organiser dataset defines them differently
INCOME_BRACKETS=<1.5L,1.5-3L,3-6L,>6L,prefer_not_to_say

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
