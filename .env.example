# Backend (copy to backend/.env)
DATABASE_URL=sqlite:///./samvaad.db
LLM_MODE=mock                    # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
ANTHROPIC_FALLBACKS=                # "default" enables server-side refusal fallback (verify with a real call first)
ADMIN_PIN=change-me
COUNSELLOR_PIN=change-me
PHONE_ENCRYPTION_KEY=            # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CORS_ORIGINS=http://localhost:5173
# Optional: income bands (comma-separated slugs) if the organiser dataset defines them differently
INCOME_BRACKETS=<1.5L,1.5-3L,3-6L,>6L,prefer_not_to_say

# Frontend (copy to frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
